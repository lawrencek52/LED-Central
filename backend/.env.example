# LED-Central Backend Configuration
# Copy this file to .env and update values as needed

NODE_ENV=development
HOST=0.0.0.0
PORT=3001
API_TIMEOUT=30000
EFFECT_DATABASE_PATH=./data/led-central.db
AUTH_TOKEN=

# Optional: Log level (debug, info, warn, error)
LOG_LEVEL=info

# Optional: CORS allowed origins. Use * for LAN testing from phones/browsers on the same network.
CORS_ORIGIN=*
