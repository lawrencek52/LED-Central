{
  "folders": [
    {
      "path": ".",
      "name": "LED-Central (Root)"
    },
    {
      "path": "backend",
      "name": "Backend (Node.js)"
    },
    {
      "path": "frontend",
      "name": "Frontend (React)"
    }
  ],
  "settings": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "[python]": {
      "editor.defaultFormatter": "ms-python.python"
    },
    "files.exclude": {
      "**/node_modules": true,
      "**/__pycache__": true
    },
    "search.exclude": {
      "**/node_modules": true,
      "**/dist": true,
      "**/build": true
    }
  },
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "name": "Backend (Node.js)",
        "type": "node",
        "request": "launch",
        "program": "${workspaceFolder:Backend (Node.js)}/src/server.js",
        "restart": true,
        "console": "integratedTerminal",
        "cwd": "${workspaceFolder:Backend (Node.js)}"
      }
    ]
  }
}
